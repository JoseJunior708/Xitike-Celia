<!DOCTYPE html>
<html lang="pt" class="dark">
<head>
  <meta charset="UTF-8" />
  <script src="https://cdn.tailwindcss.com"></script>
  <script>tailwind.config = { darkMode: 'media' }</script>
  <title>Xitike Célia</title>
</head>
<body class="bg-zinc-100 dark:bg-black min-h-screen flex items-center justify-center p-6 transition-colors duration-500">

  <div class="w-full max-w-md bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 p-8 rounded-3xl shadow-2xl">
    <div class="text-center mb-8">
      <div class="w-20 h-20 rounded-full bg-zinc-800 border-2 border-pink-500 flex items-center justify-center text-lg font-black text-pink-500 overflow-hidden mx-auto mb-4 relative">
        <span id="logoIniciais">XC</span>
        <img src="/logo" alt="Logo" style="display:none"
             onload="document.getElementById('logoIniciais').style.display='none'; this.style.display='block';"
             onerror="this.style.display='none'"
             class="w-20 h-20 rounded-full object-cover absolute inset-0">
      </div>
      <h2 class="text-3xl font-black text-pink-600">Xitike Célia</h2>
      <p class="text-zinc-500 mt-2">Painel de gestão dos xitiques.</p>
    </div>

    <form method="POST" action="/login" class="space-y-6">
      <input type="text" name="website" tabindex="-1" autocomplete="off"
             style="position:absolute; left:-9999px; opacity:0; height:0; width:0;">

      <div class="relative">
        <label class="block text-sm font-bold text-zinc-700 dark:text-zinc-300 mb-2">Chave de Acesso</label>

        <input type="password" name="senha" id="campoSenha" required autofocus
               class="w-full p-4 pr-20 rounded-xl bg-zinc-100 dark:bg-zinc-800 border border-zinc-300 dark:border-zinc-700 focus:border-pink-500 outline-none transition-all text-center tracking-widest text-lg font-bold">

        <button type="button" onclick="alternarSenha()" id="btnSenha"
                class="absolute right-4 top-[2.4rem] text-xs font-bold text-pink-600 hover:text-pink-400 uppercase tracking-wider transition-colors">
          Mostrar
        </button>
      </div>

      <% if (typeof erro !== 'undefined' && erro) { %>
        <p class="text-red-500 text-sm font-bold text-center mt-2"><%= erro %></p>
      <% } %>

      <button type="submit" class="w-full py-4 bg-pink-600 hover:bg-pink-700 text-white font-bold rounded-xl shadow-lg shadow-pink-500/30 transition-all">
        Entrar no Painel
      </button>
    </form>

    <script>
      function alternarSenha() {
        const campo = document.getElementById('campoSenha');
        const botao = document.getElementById('btnSenha');
        if (campo.type === 'password') {
          campo.type = 'text';
          botao.innerText = 'Ocultar';
        } else {
          campo.type = 'password';
          botao.innerText = 'Mostrar';
        }
      }
    </script>
  </div>
</body>
</html>
